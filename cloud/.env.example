# Server
PORT=8787
HOST=0.0.0.0
NODE_ENV=development

# Public origins
PUBLIC_BASE_URL=http://localhost:8787
PWA_ORIGIN=http://localhost:5173
# Comma-separated extra CORS origins (production PWA is always allowed)
CORS_ORIGINS=http://localhost:5173,https://app.getpocket.device

# Auth / sessions
SESSION_SECRET=dev-change-me-to-a-long-random-string
SESSION_COOKIE_NAME=pocket_session
SESSION_TTL_DAYS=30
MAGIC_LINK_TTL_MINUTES=15
# In development, magic-link URLs are logged to the console instead of emailed
# SMTP_* reserved for later email delivery

# Device API (factory / pre-pair attestation)
DEVICE_API_KEY=dev-device-api-key

# SQLite database path (sql.js WASM; file persisted on disk)
DATABASE_PATH=./data/pocket-cloud.sqlite

# Stripe — leave STRIPE_SECRET_KEY unset to run in mock billing mode
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY_ID=
# Product display name must remain "Pocket Cloud" (never "Connect")
STRIPE_PRODUCT_NAME=Pocket Cloud

# Backup retention (minimum 3)
BACKUP_RETENTION_COUNT=3

# Share links
SHARE_DEFAULT_EXPIRY_DAYS=30
